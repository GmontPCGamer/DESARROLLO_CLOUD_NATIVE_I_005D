{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "productId",
    "title",
    "reason",
    "reviewCount"
  ],
  "properties": {
    "productId": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "reviewCount": {
      "type": "integer",
      "minimum": 1
    }
  }
}
