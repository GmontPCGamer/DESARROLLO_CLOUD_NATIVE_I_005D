aws_region     = "us-east-1"
nombre_proyecto = "cloud-native-005d"

# URL del backend Spring Boot (ALB o ECS service discovery).
url_backend = "https://REEMPLAZAR-URL-BACKEND"

# CORS: dominios donde está publicado el frontend Angular.
cors_origenes = ["https://REEMPLAZAR-DOMINIO-FRONTEND"]

# Authorizer JWT de Azure AD (Entra ID). Con el issuer validado por JWKS no
# se necesitan secrets; sólo issuer + audiencia (clientId).
issuer_uri = "https://login.microsoftonline.com/REEMPLAZAR-TENANT/v2.0"
audiencia  = "REEMPLAZAR-CLIENT-ID"

# Microsoft Entra ID. Usa Azure CLI (az login) y activa esta sección sólo
# cuando quieras que Terraform cree los registros de aplicación.
gestionar_entra  = true
azure_tenant_id  = "REEMPLAZAR-TENANT-ID"
entra_api_nombre = "NexoTech API"
entra_api_identifier_uri = "api://nexotech-api"
entra_spa_nombre = "NexoTech SPA"
spa_redirect_uris = ["http://localhost:4200/auth"]
spa_logout_uris   = ["http://localhost:4200"]
entra_student_app_nombre = "NexoTech Student"
entra_student_identifier_uri = "api://nexotech-student-api"
